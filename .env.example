# PostgreSQL connection string. On Neon use the *pooled* connection string
# (host contains "-pooler") and keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Secret used to sign session tokens (JWT). At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Port for the local API server (development only; Vercel ignores it)
API_PORT=3001
